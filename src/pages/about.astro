---
import Timeline from '../components/Timeline.jsx';
import Nav from '../components/Nav.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="About Amanda Koh - Designer, Builder, Researcher" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Dancing+Script:wght@400;500;600;700&family=Square+Peg&family=Staatliches&display=swap" rel="stylesheet" />

    <title>About | Amanda Koh</title>
  </head>
  <body class="min-h-screen bg-[#5A314D] relative">
    <!-- Blue gradient left side -->
    <div
      class="fixed top-0 left-0 w-full h-full pointer-events-none z-0"
      style="background: linear-gradient(to right, rgba(25, 34, 77, 0.6) 0%, transparent 30%)"
      aria-hidden="true"
    ></div>
    <!-- Blue gradient right side -->
    <div
      class="fixed top-0 right-0 w-full h-full pointer-events-none z-0"
      style="background: linear-gradient(to left, rgba(25, 34, 77, 0.6) 0%, transparent 30%)"
      aria-hidden="true"
    ></div>

    <Nav currentPage="about" />

    <!-- Hero Section -->
    <section class="relative z-10 pt-24 sm:pt-32 pb-12 sm:pb-16 px-4 sm:px-6 lg:px-8">
      <div class="container mx-auto max-w-4xl text-center">
        <h1 class="font-ebrula text-5xl sm:text-6xl md:text-7xl lg:text-8xl xl:text-9xl text-[#FC6B55] leading-tight mb-6 sm:mb-8">
          About
        </h1>
        <p class="font-body text-white/90 text-base sm:text-lg md:text-xl lg:text-2xl leading-relaxed max-w-2xl mx-auto">
          Having tried a whole bunch of things, I've narrowed down what I like working on to (1) complex problems and (2) building things up from scratch. I thrive on ambiguity and being trusted to experiment responsibly. Wherever that takes me, I just want to keep building cool stuff.
        </p>
      </div>
    </section>

    <!-- Timeline Section -->
    <section class="relative z-10 overflow-visible">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-5xl">
        <div class="md:sticky top-16 sm:top-20 z-40 text-center mb-8 md:mb-12 py-4 bg-transparent">
          <h2 class="font-square-peg text-[#FAE397] text-4xl sm:text-5xl md:text-6xl">
            the journey so far...
          </h2>
        </div>
        <Timeline client:visible />
      </div>
    </section>

  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
