---
import ExperienceCard from './ExperienceCard.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';

import kedroBackground from '../assets/backgrounds/kedro-background.png';
import mavenBackground from '../assets/backgrounds/maven-background.png';
import improbableBackground from '../assets/backgrounds/improbable-background.png';
import kedroLogo from '../assets/logos/kedro-logo.png';
import mavenLogo from '../assets/logos/maven-logo.png';
import improbableLogo from '../assets/logos/improbable-logo.png';
import quantumblackLogo from '../assets/logos/quantumblack-logo.png';
import quantcoLogo from '../assets/logos/quantco-logo.png';
import quantcoBackground from '../assets/backgrounds/quantco-background.png';

// Fetch project descriptions
const projects = await getCollection('projects');
const quantcoProject = projects.find(p => p.slug === 'quantco');
const quantumblackProject = projects.find(p => p.slug === 'quantumblack');
const mavenProject = projects.find(p => p.slug === 'maven');
const improbableProject = projects.find(p => p.slug === 'improbable');
---

<section id="work" class="relative overflow-hidden py-12 sm:py-16 lg:py-20 2xl:py-12 z-10">
  {/* Container */}
  <div class="relative container mx-auto px-4 sm:px-6 lg:px-8 max-w-7xl">

    {/* Middle Section: Work Title, Company Logos, and Current Work Indicator */}
    <div class="mb-2 sm:mb-3">
      {/* Work Title */}
      <div class="text-center">
        <h2 class="font-ebrula text-6xl sm:text-7xl lg:text-8xl xl:text-9xl text-[#FC6B55] leading-tight">
          Work
        </h2>
      </div>
    </div>

    {/* Bottom Section: Work Experience Cards */}
    <div class="relative">
      {/* "I work here" indicator positioned above the first card */}
      <div class="flex items-center justify-center md:justify-start md:pl-12 mb-1 max-w-3xl mx-auto">
        <p class="font-square-peg text-[#FC6B55] text-[28px] sm:text-[40px]">
          i work here now
        </p>
        <svg
          class="w-8 h-8 sm:w-10 sm:h-10 text-[#FC6B55] ml-2 mt-5 sm:mt-6"
          viewBox="0 0 40 40"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M2 10 Q20 10 20 30" />
          <path d="M18 28 L20 31 L22 28" />
        </svg>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 sm:gap-8 max-w-3xl mx-auto">
      {/* QuantCo - Founding Designer */}
      <ExperienceCard
        backgroundImage={quantcoBackground}
        logoImage={quantcoLogo}
        logoImageAlt="QuantCo"
        jobRole="Founding Designer"
        companyName="QuantCo"
        description={quantcoProject?.data.title || ""}
        alt="QuantCo Case Studio platform interface"
        href="/work/quantco?from=work"
      />

      {/* QuantumBlack - Technical UX Designer */}
      <ExperienceCard
        backgroundImage={kedroBackground}
        logoImage={quantumblackLogo}
        logoImageAlt="QuantumBlack"
        jobRole="Technical Product Designer"
        companyName="QuantumBlack"
        description={quantumblackProject?.data.title || ""}
        alt="Kedro framework interface background"
        href="/work/quantumblack?from=work"
      />

      {/* Maven - Lead Designer */}
      <ExperienceCard
        backgroundImage={mavenBackground}
        logoImage={mavenLogo}
        logoImageAlt="Maven"
        jobRole="Lead Designer"
        companyName="Maven"
        description={mavenProject?.data.title || ""}
        alt="Maven trading interface background"
        href="/work/maven?from=work"
      />

      {/* Improbable - UX Engineer */}
      <ExperienceCard
        backgroundImage={improbableBackground}
        logoImage={improbableLogo}
        logoImageAlt="Improbable"
        jobRole="UX Engineer"
        companyName="Improbable"
        description={improbableProject?.data.title || ""}
        alt="Improbable abstract geometric background"
        href="/work/improbable?from=work"
      />
      </div>
    </div>
  </div>
</section>
