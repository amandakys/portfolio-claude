---
// Password protection overlay component
// Shows a password input that must be entered before content is revealed
import Nav from './Nav.astro';

const STORAGE_KEY = 'portfolio-authenticated';
---

<script is:inline define:vars={{ STORAGE_KEY }}>
  // Check immediately before render - if already authenticated, hide overlay
  if (sessionStorage.getItem(STORAGE_KEY) === 'true') {
    document.documentElement.classList.add('pw-authenticated');
  }
</script>

<style is:global>
  .pw-authenticated #password-overlay {
    display: none !important;
  }
</style>

<div id="password-overlay" class="fixed inset-0 z-50 flex items-center justify-center bg-[#19224D] overflow-hidden">
  <!-- Red gradient overlay top left -->
  <div
    class="absolute top-0 left-0 w-full h-full pointer-events-none z-0"
    style="background: radial-gradient(ellipse at top left, rgba(252, 107, 85, 0.35) 0%, rgba(252, 107, 85, 0.15) 30%, transparent 60%)"
    aria-hidden="true"
  ></div>

  <!-- Header -->
  <Nav />

  <!-- Animated hazard tape background -->
  <div class="absolute inset-0 pointer-events-none">
    <!-- Tape 1 - top left, angled down-right -->
    <div class="tape tape-1" style="top: 5%; transform: rotate(15deg);">
