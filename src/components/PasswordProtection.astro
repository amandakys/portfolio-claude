        <div class="tape-group"><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span></div>
      </div>
    </div>
    <!-- Tape 2 - upper area, angled up-right -->
    <div class="tape tape-2" style="top: 15%; transform: rotate(-12deg);">
      <div class="tape-text">
        <div class="tape-group"><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span></div>
        <div class="tape-group"><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span></div>
      </div>
    </div>
    <!-- Tape 3 - middle upper, angled down-right -->
    <div class="tape tape-3" style="top: 28%; transform: rotate(8deg);">
      <div class="tape-text">
        <div class="tape-group"><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span></div>
        <div class="tape-group"><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span></div>
      </div>
    </div>
    <!-- Tape 4 - lower middle, angled down-right -->
    <div class="tape tape-4" style="top: 62%; transform: rotate(18deg);">
      <div class="tape-text">
        <div class="tape-group"><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span></div>
        <div class="tape-group"><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span></div>
      </div>
    </div>
    <!-- Tape 5 - bottom area, angled up-right -->
    <div class="tape tape-5" style="top: 75%; transform: rotate(-15deg);">
      <div class="tape-text">
        <div class="tape-group"><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span></div>
        <div class="tape-group"><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span></div>
      </div>
    </div>
    <!-- Tape 6 - very bottom, angled down-right -->
    <div class="tape tape-6" style="top: 88%; transform: rotate(10deg);">
      <div class="tape-text">
        <div class="tape-group"><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span></div>
        <div class="tape-group"><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span><span>PASSWORD PROTECTED</span></div>
      </div>
    </div>
