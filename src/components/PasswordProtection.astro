  <!-- Form container -->
  <div class="relative z-10 w-full max-w-md px-8 py-12 bg-[#19224D]/30 backdrop-blur-sm rounded-lg">
    <div class="text-center mb-8">
      <h2 class="font-ebrula text-4xl sm:text-5xl text-[#FC6B55] mb-4">Protected Content</h2>
      <p class="font-body text-white/70">This project is password protected. Please enter the password to view.</p>
    </div>

    <form id="password-form" class="space-y-4">
      <div>
        <input
          type="password"
          id="password-input"
          placeholder="Enter password"
          class="w-full px-4 py-3 bg-white/10 border border-white/20 rounded-lg text-white placeholder-white/40 font-body focus:outline-none focus:border-[#FC6B55] focus:ring-1 focus:ring-[#FC6B55]"
          autocomplete="current-password"
        />
      </div>
      <p id="password-error" class="text-[#FC6B55] text-sm font-body hidden">Incorrect password. Please try again.</p>
      <button
        type="submit"
        class="w-full px-4 py-3 bg-[#FC6B55] text-white font-job-role tracking-wide rounded-lg hover:bg-[#e55a45] transition-colors"
      >
        Unlock
      </button>
    </form>
  </div>
</div>

<style>
  .tape {
    position: absolute;
    left: -20%;
    width: 140%;
    height: 32px;
    background-color: #FAE397;
    overflow: hidden;
    opacity: 0.9;
  }

  .tape-text {
    display: flex;
    white-space: nowrap;
    width: max-content;
    animation: scroll-tape 20s linear infinite;
  }

  .tape-group {
    display: flex;
    flex-shrink: 0;
  }

  .tape-text span {
    font-family: 'Staatliches', sans-serif;
    font-size: 14px;
    letter-spacing: 0.15em;
    color: #19224D;
    padding: 8px 24px;
    text-transform: uppercase;
    flex-shrink: 0;
  }

  .tape-1 .tape-text { animation-duration: 60s; }
  .tape-2 .tape-text { animation-duration: 55s; animation-direction: reverse; }
  .tape-3 .tape-text { animation-duration: 65s; }
  .tape-4 .tape-text { animation-duration: 50s; animation-direction: reverse; }
  .tape-5 .tape-text { animation-duration: 58s; }
  .tape-6 .tape-text { animation-duration: 62s; animation-direction: reverse; }

  @keyframes scroll-tape {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }
</style>

<script is:inline>
  (function() {
    const PASSWORD = 'Pl3aseL3tMe1n';
    const STORAGE_KEY = 'portfolio-authenticated';

    const overlay = document.getElementById('password-overlay');
    const form = document.getElementById('password-form');
    const input = document.getElementById('password-input');
    const error = document.getElementById('password-error');

    // Check if already authenticated
    if (sessionStorage.getItem(STORAGE_KEY) === 'true') {
      overlay?.remove();
      return;
    }

    form?.addEventListener('submit', function(e) {
      e.preventDefault();

      if (input.value === PASSWORD) {
        sessionStorage.setItem(STORAGE_KEY, 'true');
        document.documentElement.classList.add('pw-authenticated');
        overlay?.remove();
      } else {
        error?.classList.remove('hidden');
        input.value = '';
        input.focus();
      }
    });
  })();
</script>
