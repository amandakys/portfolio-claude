---
import { Image } from 'astro:assets';
import logo from '../assets/logos/amanda-logo.png';
import CvButton from './CvButton.jsx';

interface Props {
  currentPage?: string;
}

const { currentPage = '' } = Astro.props;
---

<nav id="main-nav" class="fixed top-0 left-0 right-0 z-50 p-4 sm:p-6 flex justify-between items-center transition-all duration-300">
  <a
    href="/"
    class="hover:opacity-80 transition-opacity z-50"
  >
    <Image src={logo} alt="Amanda Koh" class="h-8 sm:h-10 w-auto" />
  </a>

  <!-- Desktop Nav Links -->
  <ul class="hidden sm:flex gap-6 sm:gap-8">
    <li>
      <a
        href="/about"
        class={`nav-circle-link font-job-role tracking-wide text-sm sm:text-base transition-opacity relative inline-block text-white ${
          currentPage === 'about' ? '' : 'hover:opacity-100'
        }`}
      >
        About
        <svg class="nav-circle-svg" viewBox="0 0 120 50" preserveAspectRatio="none" aria-hidden="true">
          <ellipse cx="60" cy="25" rx="55" ry="20" class={`nav-circle-path ${currentPage === 'about' ? 'nav-circle-active' : ''}`} />
        </svg>
      </a>
    </li>
    <li>
      <a
        href="/#work"
        class={`nav-circle-link font-job-role tracking-wide text-sm sm:text-base transition-opacity relative inline-block text-white ${
          currentPage === 'work' ? '' : 'hover:opacity-100'
        }`}
      >
        Work
        <svg class="nav-circle-svg" viewBox="0 0 120 50" preserveAspectRatio="none" aria-hidden="true">
          <ellipse cx="60" cy="25" rx="55" ry="20" class={`nav-circle-path ${currentPage === 'work' ? 'nav-circle-active' : ''}`} />
        </svg>
      </a>
    </li>
    <li>
      <a
        href="/projects"
        class={`nav-circle-link font-job-role tracking-wide text-sm sm:text-base transition-opacity relative inline-block text-white ${
          currentPage === 'projects' ? '' : 'hover:opacity-100'
        }`}
      >
        Projects
        <svg class="nav-circle-svg" viewBox="0 0 120 50" preserveAspectRatio="none" aria-hidden="true">
          <ellipse cx="60" cy="25" rx="55" ry="20" class={`nav-circle-path ${currentPage === 'projects' ? 'nav-circle-active' : ''}`} />
        </svg>
      </a>
    </li>
    <li>
      <CvButton client:load />
    </li>
  </ul>

  <!-- Mobile Hamburger Button -->
  <button
    id="menu-toggle"
    class="sm:hidden z-50 p-2 text-white hover:opacity-80 transition-opacity"
    aria-label="Toggle menu"
    aria-expanded="false"
  >
    <svg id="hamburger-icon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
    </svg>
    <svg id="close-icon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
    </svg>
  </button>
</nav>

<!-- Mobile Menu Overlay -->
<div
  id="mobile-menu"
  class="fixed inset-0 z-40 bg-[#19224D] flex-col items-center justify-center gap-8 transform translate-x-full transition-transform duration-300 ease-in-out hidden"
>
  <a
    href="/about"
    class={`font-job-role tracking-wide text-2xl transition-opacity ${
      currentPage === 'about' ? 'text-[#FAE397]' : 'text-white hover:opacity-80'
    }`}
  >
    About
  </a>
  <a
    href="/#work"
    class={`font-job-role tracking-wide text-2xl transition-opacity ${
      currentPage === 'work' ? 'text-[#FAE397]' : 'text-white hover:opacity-80'
    }`}
  >
    Work
  </a>
  <a
    href="/projects"
    class={`font-job-role tracking-wide text-2xl transition-opacity ${
      currentPage === 'projects' ? 'text-[#FAE397]' : 'text-white hover:opacity-80'
    }`}
  >
    Projects
  </a>
  <CvButton client:load />
</div>

<style is:global>
  .nav-circle-link {
    position: relative;
    display: inline-block;
  }

  .nav-circle-svg {
    position: absolute;
    top: 50%;
    left: 50%;
    width: calc(100% + 20px);
    height: calc(100% + 16px);
    transform: translate(-50%, -50%);
    pointer-events: none;
    overflow: visible;
  }

  .nav-circle-path {
    fill: none;
    stroke: #ffffff;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-dasharray: 250;
    stroke-dashoffset: 250;
    transition: stroke-dashoffset 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .nav-circle-link:hover .nav-circle-path {
    stroke-dashoffset: 0;
  }

  .nav-circle-active {
    stroke-dashoffset: 0;
  }
</style>

<script>
  const nav = document.getElementById('main-nav');
  const menuToggle = document.getElementById('menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const hamburgerIcon = document.getElementById('hamburger-icon');
  const closeIcon = document.getElementById('close-icon');

  function updateNavBackground() {
    if (window.scrollY > 50) {
      nav?.classList.add('backdrop-blur-md');
    } else {
      nav?.classList.remove('backdrop-blur-md');
    }
  }

  function toggleMenu() {
    const isOpen = mobileMenu?.classList.contains('translate-x-0');

    if (isOpen) {
      // Close menu
      mobileMenu?.classList.remove('translate-x-0');
      mobileMenu?.classList.add('translate-x-full');
      hamburgerIcon?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
      menuToggle?.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
      // Hide after animation
      setTimeout(() => {
        mobileMenu?.classList.add('hidden');
        mobileMenu?.classList.remove('flex');
      }, 300);
    } else {
      // Open menu
      mobileMenu?.classList.remove('hidden');
      mobileMenu?.classList.add('flex');
      // Trigger reflow for animation
      mobileMenu?.offsetHeight;
      mobileMenu?.classList.remove('translate-x-full');
      mobileMenu?.classList.add('translate-x-0');
      hamburgerIcon?.classList.add('hidden');
      closeIcon?.classList.remove('hidden');
      menuToggle?.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
    }
  }

  menuToggle?.addEventListener('click', toggleMenu);

  // Close menu when clicking a link
  mobileMenu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      toggleMenu();
    });
  });

  window.addEventListener('scroll', updateNavBackground);
  updateNavBackground();
</script>
