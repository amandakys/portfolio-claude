---
import { Image } from 'astro:assets';
import logo from '../assets/logos/amanda-logo.png';

interface Props {
  currentPage?: string;
}

const { currentPage = '' } = Astro.props;
---

<nav id="main-nav" class="fixed top-0 left-0 right-0 z-50 p-4 sm:p-6 flex justify-between items-center transition-all duration-300">
  <a
    href="/"
    class="hover:opacity-80 transition-opacity"
  >
    <Image src={logo} alt="Amanda Koh" class="h-8 sm:h-10 w-auto" />
  </a>
  <ul class="flex gap-6 sm:gap-8">
    <li>
      <a
        href="/about"
        class={`font-job-role tracking-wide text-sm sm:text-base transition-opacity ${
          currentPage === 'about' ? 'text-[#FAE397]' : 'text-white hover:opacity-80'
        }`}
      >
        About
      </a>
    </li>
    <li>
      <a
        href="/#work"
        class={`font-job-role tracking-wide text-sm sm:text-base transition-opacity ${
          currentPage === 'work' ? 'text-[#FAE397]' : 'text-white hover:opacity-80'
        }`}
      >
        Work
      </a>
    </li>
    <li>
      <a
        href="/projects"
        class={`font-job-role tracking-wide text-sm sm:text-base transition-opacity ${
          currentPage === 'projects' ? 'text-[#FAE397]' : 'text-white hover:opacity-80'
        }`}
      >
        Projects
      </a>
    </li>
  </ul>
</nav>

<script>
  const nav = document.getElementById('main-nav');

  function updateNavBackground() {
    if (window.scrollY > 50) {
      nav?.classList.add('backdrop-blur-md');
    } else {
      nav?.classList.remove('backdrop-blur-md');
    }
  }

  window.addEventListener('scroll', updateNavBackground);
  updateNavBackground();
</script>
