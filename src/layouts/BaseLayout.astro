---
interface Props {
  title?: string;
  description?: string;
}

const { title = "Amanda Koh | Portfolio", description = "Portfolio of Amanda Koh - Product Designer" } = Astro.props;
---

<!doctype html>
<html lang="en" class="overflow-x-hidden">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />

    <!-- Preload custom fonts to reduce FOUT -->
    <link rel="preload" href="/fonts/EbrulaVintageDemo-Regular.otf" as="font" type="font/otf" crossorigin />
    <link rel="preload" href="/fonts/Roslindale-DisplayCondensedBold-Testing.otf" as="font" type="font/otf" crossorigin />

    <!-- Open Graph / Social sharing -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/social-image.png" />
    <meta property="og:type" content="website" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="/social-image.png" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Dancing+Script:wght@400;500;600;700&family=Square+Peg&family=Staatliches&display=swap" rel="stylesheet" />

    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-[#19224D] overflow-x-hidden">
    <slot />
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
