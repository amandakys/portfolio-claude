---
import type { CollectionEntry } from 'astro:content';
import PasswordProtection from '../components/PasswordProtection.astro';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  entry: CollectionEntry<'projects'>;
  headings?: Heading[];
}

const { entry, headings = [] } = Astro.props;
const { title, tags, description, workplace } = entry.data;
const isProtected = entry.data.protected === true;
const isWorkProject = !!workplace;

// Filter to only h2 headings for the table of contents
const tocHeadings = headings.filter(h => h.depth === 2);
---

<!doctype html>
<html lang="en" class="overflow-x-hidden">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={entry.data.description} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Dancing+Script:wght@400;500;600;700&family=Square+Peg&family=Staatliches&display=swap" rel="stylesheet" />

    <title>{title} | Amanda Koh</title>
  </head>
  <body class="min-h-screen lg:overflow-hidden overflow-x-hidden">
    {isProtected && <PasswordProtection />}
    <div class="flex flex-col lg:flex-row lg:h-screen">
      <!-- Left Side - Fixed on desktop, top on mobile -->
      <aside class="w-full lg:w-[30%] bg-[#19224D] flex flex-col justify-between pt-0 px-8 pb-8 sm:px-12 sm:pb-12 lg:p-16 shrink-0 lg:overflow-y-auto relative">
        <!-- Top row: Back link and hamburger menu - sticky on mobile -->
        <div
          id="project-top-bar"
          class="lg:static fixed top-0 left-0 right-0 z-40 flex justify-between items-center px-4 py-2 sm:px-6 sm:py-3 lg:p-0 lg:mb-8 transition-all duration-300"
        >
          <!-- Back link -->
          <a
            id="back-link"
            href={isWorkProject ? "/#work" : "/projects"}
            class="inline-flex items-center gap-2 font-job-role text-white/60 tracking-wide text-sm hover:text-white transition-colors"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
            </svg>
            <span id="back-label">{isWorkProject ? "Work" : "Projects"}</span>
          </a>

          <!-- Mobile Hamburger Button -->
          <button
            id="project-menu-toggle"
            class="lg:hidden p-2 text-white hover:opacity-80 transition-opacity"
            aria-label="Toggle menu"
            aria-expanded="false"
          >
            <svg id="project-hamburger-icon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
            <svg id="project-close-icon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>

        <!-- Spacer for fixed header on mobile -->
        <div class="h-10 sm:h-12 lg:hidden"></div>

        <div>

          <!-- Title -->
          <h1 class="font-ebrula text-5xl sm:text-6xl md:text-7xl lg:text-[80px] text-[#FC6B55] leading-tight">
            {title}
          </h1>

          <!-- Tags and Workplace -->
          {(tags && tags.length > 0) || workplace ? (
            <div class="flex flex-wrap items-center justify-between gap-2 mt-3 lg:mt-4">
              <div class="flex flex-wrap gap-2">
                {tags && tags.map((tag: string) => (
                  <span class="font-body text-sm px-3 py-1.5 bg-white/20 text-white/80 rounded">
                    {tag}
                  </span>
                ))}
              </div>
              {workplace && (
                <p class="font-body text-white/60 text-sm">
                  {workplace}
                </p>
              )}
            </div>
          ) : null}

          <!-- Description -->
          {description && (
            <p class="font-body text-white/80 text-base sm:text-lg mt-4 lg:mt-6 leading-relaxed">
              {description}
            </p>
          )}
        </div>

        <!-- Table of Contents -->
        {tocHeadings.length > 0 && (
          <nav class="hidden lg:block mt-8 text-right">
            <h2 class="font-job-role text-white/40 tracking-wide text-xs uppercase mb-3">Contents</h2>
            <ul class="space-y-2">
              {tocHeadings.map((heading) => (
                <li>
                  <a
                    href={`#${heading.slug}`}
                    class="font-body text-white/60 text-sm hover:text-white transition-colors block"
                  >
                    {heading.text}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )}
      </aside>

      <!-- Right Side - Scrollable -->
      <main id="main-content" class="flex-1 bg-[#FEFAEC] lg:overflow-y-auto scroll-smooth">
        <!-- Navigation - Desktop only -->
        <nav class="sticky top-0 bg-[#FEFAEC]/80 backdrop-blur-sm z-10 hidden lg:flex justify-end gap-4 sm:gap-6 lg:gap-8 p-4 sm:p-6 lg:p-8">
          <a
            href="/about"
            class="font-job-role text-[#19224D] tracking-wide text-sm sm:text-base hover:opacity-70 transition-opacity"
          >
            About
          </a>
          <a
            href="/#work"
            class="font-job-role text-[#19224D] tracking-wide text-sm sm:text-base hover:opacity-70 transition-opacity"
          >
            Work
          </a>
          <a
            href="/projects"
            class="font-job-role text-[#19224D] tracking-wide text-sm sm:text-base hover:opacity-70 transition-opacity"
          >
            Projects
          </a>
        </nav>

        <!-- Content -->
        <article class="px-8 sm:px-12 lg:px-20 xl:px-28 pb-16 prose prose-lg prose-gray max-w-none
          prose-headings:font-heading prose-headings:text-[#FC6B55]
          prose-h2:text-2xl prose-h2:sm:text-3xl prose-h2:mt-12 prose-h2:mb-6
          prose-h3:text-xl prose-h3:sm:text-2xl
          prose-h4:text-lg prose-h4:sm:text-xl prose-h4:font-semibold prose-h4:text-[#FC6B55] prose-h4:font-heading
          prose-p:font-body prose-p:text-gray-700 prose-p:leading-relaxed
          prose-a:text-[#FC6B55] prose-a:no-underline prose-a:hover:underline
          prose-strong:text-[#19224D]
          prose-img:rounded-lg prose-img:shadow-md prose-img:mx-auto
          prose-ul:font-body prose-li:text-gray-700
        ">
          <slot />
        </article>
      </main>
    </div>

    <!-- Mobile Menu Overlay -->
    <div
      id="project-mobile-menu"
      class="fixed inset-0 z-50 bg-[#19224D] flex-col items-center justify-center gap-8 transform translate-x-full transition-transform duration-300 ease-in-out hidden lg:hidden"
    >
      <!-- Close button in top right -->
      <button
        id="project-menu-close"
        class="absolute top-6 right-6 p-2 text-white hover:opacity-80 transition-opacity"
        aria-label="Close menu"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>

      <a
        href="/about"
        class="font-job-role tracking-wide text-2xl text-white hover:opacity-80 transition-opacity"
      >
        About
      </a>
      <a
        href="/#work"
        class="font-job-role tracking-wide text-2xl text-white hover:opacity-80 transition-opacity"
      >
        Work
      </a>
      <a
        href="/projects"
        class="font-job-role tracking-wide text-2xl text-white hover:opacity-80 transition-opacity"
      >
        Projects
      </a>
    </div>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';

  /* Caption styling - paragraphs with small font size */
  article p[style*="font-size: 0.8em"] {
    position: static !important;
    top: auto !important;
    margin-top: 0.5rem !important;
    margin-bottom: 1.5rem !important;
    color: #6b7280 !important;
    text-align: center;
  }

  /* Center all images including HTML img tags */
  article img {
    display: block;
    margin-left: auto;
    margin-right: auto;
  }
</style>

<script is:inline>
  // Update back link based on query parameter
  (function() {
    const params = new URLSearchParams(window.location.search);
    const from = params.get('from');
    const backLink = document.getElementById('back-link');
    const backLabel = document.getElementById('back-label');

    if (from === 'projects' && backLink && backLabel) {
      backLink.href = '/projects';
      backLabel.textContent = 'Projects';
    } else if (from === 'work' && backLink && backLabel) {
      backLink.href = '/#work';
      backLabel.textContent = 'Work';
    }
  })();

  // Handle TOC anchor clicks for scrollable container
  (function() {
    const tocLinks = document.querySelectorAll('aside nav a[href^="#"]');
    const mainContent = document.getElementById('main-content');

    tocLinks.forEach(function(link) {
      link.addEventListener('click', function(e) {
        const href = link.getAttribute('href');
        if (!href || !mainContent) return;

        const targetId = href.substring(1);
        const targetElement = document.getElementById(targetId);

        if (targetElement) {
          e.preventDefault();
          const navHeight = 80; // Account for sticky nav
          const targetPosition = targetElement.offsetTop - navHeight;
          mainContent.scrollTo({
            top: targetPosition,
            behavior: 'smooth'
          });
        }
      });
    });
  })();

  // Sticky top bar background on scroll
  (function() {
    const topBar = document.getElementById('project-top-bar');

    function updateTopBarBackground() {
      if (window.scrollY > 20) {
        topBar?.classList.add('bg-[#19224D]/90', 'backdrop-blur-md');
      } else {
        topBar?.classList.remove('bg-[#19224D]/90', 'backdrop-blur-md');
      }
    }

    window.addEventListener('scroll', updateTopBarBackground);
    updateTopBarBackground();
  })();

  // Mobile menu toggle
  (function() {
    const menuToggle = document.getElementById('project-menu-toggle');
    const menuClose = document.getElementById('project-menu-close');
    const mobileMenu = document.getElementById('project-mobile-menu');
    const hamburgerIcon = document.getElementById('project-hamburger-icon');
    const closeIcon = document.getElementById('project-close-icon');

    function openMenu() {
      mobileMenu?.classList.remove('hidden');
      mobileMenu?.classList.add('flex');
      mobileMenu?.offsetHeight; // Trigger reflow
      mobileMenu?.classList.remove('translate-x-full');
      mobileMenu?.classList.add('translate-x-0');
      hamburgerIcon?.classList.add('hidden');
      closeIcon?.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }

    function closeMenu() {
      mobileMenu?.classList.remove('translate-x-0');
      mobileMenu?.classList.add('translate-x-full');
      hamburgerIcon?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
      document.body.style.overflow = '';
      setTimeout(function() {
        mobileMenu?.classList.add('hidden');
        mobileMenu?.classList.remove('flex');
      }, 300);
    }

    menuToggle?.addEventListener('click', openMenu);
    menuClose?.addEventListener('click', closeMenu);

    // Close menu when clicking a link
    mobileMenu?.querySelectorAll('a').forEach(function(link) {
      link.addEventListener('click', closeMenu);
    });
  })();
</script>
